# =========================================================
# Rentas24 - Unified Environment Variables
# Shared naming across Frontend + Appwrite Functions
# =========================================================

# App
APP_ENV=local
APP_BASE_URL=http://localhost:5173
FEATURE_VERBOSE_LOGS=false

# Appwrite Core
APPWRITE_ENDPOINT=https://appwrite.racoondevs.com/v1
APPWRITE_PROJECT_ID=
APPWRITE_DB_ID=main

# Appwrite Collections
APPWRITE_COL_PROFILES_ID=profiles
APPWRITE_COL_PROPERTY_TYPES_ID=property_types
APPWRITE_COL_RENT_RECURRENCIES_ID=rent_recurrencies
APPWRITE_COL_PROPERTIES_ID=properties
APPWRITE_COL_RENTAL_PROPOSALS_ID=rental_proposals
APPWRITE_COL_RENTAL_PAYMENTS_ID=rental_payments
APPWRITE_COL_EMAIL_VERIFICATIONS_ID=email_verifications

# Appwrite Buckets
APPWRITE_BUCKET_USER_AVATARS_ID=user_avatars
APPWRITE_BUCKET_PROPERTY_PHOTOS_ID=property_photos
APPWRITE_BUCKET_USER_DOCUMENTS_ID=user_documents

# Appwrite Functions IDs (HTTP / Triggered)
APPWRITE_FUNCTION_ENSURE_PROFILE_ID=
APPWRITE_FUNCTION_SYNC_PROFILE_ID=
APPWRITE_FUNCTION_EMAIL_VERIFICATION_ID=

# Secrets (Functions / Backend only)
APPWRITE_API_KEY=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM_NAME=Rentas24
EMAIL_FROM_ADDRESS=

# Verification flow
EMAIL_VERIFICATION_TTL_MINUTES=120
